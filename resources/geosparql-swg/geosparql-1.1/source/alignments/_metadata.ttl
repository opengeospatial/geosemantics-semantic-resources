PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX schema: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

<http://www.opengis.net/ont/geosparql-alignments>
    a owl:Ontology ;
    schema:name "GeoSPARQL Alignments Ontology" ;
    schema:description "Semantic alignments between GeoSPARQL 1.1 and 17 other ontologies." ;
.
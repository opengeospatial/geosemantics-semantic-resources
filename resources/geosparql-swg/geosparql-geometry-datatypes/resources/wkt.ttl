PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov1: <http://www.w3.org/ns/prov-o#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rim: <https://w3id.org/ogc/rim/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

geo:wktLiteral
    a rdfs:Datatype ;
    dcterms:description "A Well-known Text serialization of a Geometry object."@en ;
    dcterms:title "Well-known Text literal"@en ;
    dcterms:conformsTo "https://docs.ogc.org/is/06-103r4/06-103r4.pdf"^^xsd:anyURI ;
    skos:example "<http://www.opengis.net/def/crs/EPSG/0/4326> Point(31.95 -88.38)"^^geo:wktLiteral ;
    geo:is3dCapable true ;
    geo:is2dCapable true ;
    geo:isCrsAware true ;
    geo:supportsGeometryType
        sf:Curve ,
        sf:Envelope ,
        sf:Geometry ,
        sf:GeometryCollection ,
        sf:Line ,
        sf:LineString ,
        sf:LinearRing ,
        sf:MultiCurve ,
        sf:MultiLineString ,
        sf:MultiPoint ,
        sf:MultiPolygon ,
        sf:MultiSurface ,
        sf:Point ,
        sf:Polygon ,
        sf:PolyhedralSurface ,
        sf:Surface ,
        sf:TIN ,
        sf:Triangle ;
    prov1:qualifiedAttribution
        [
            prov1:agent <https://defs.opengis.net/org/geosparql-swg> ;
            prov1:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    rim:hasAction
        [
            dcterms:isReplacedBy <https://www.opengis.net/def/vstatus/valid> ;
            prov1:atTime "2026-10-29"^^xsd:date ;
            rim:affectedProperty rim:validityStatus ;
            rim:proposer <https://defs.opengis.net/org/geosparql-swg> ;
        ] ;
    rim:inRegister <https://www.opengis.net/def/catalog/ggld> ;
.

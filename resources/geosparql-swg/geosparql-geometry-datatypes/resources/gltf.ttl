PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov-o#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rim: <https://w3id.org/ogc/rim/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

geo:asGLTF
	a rdf:Property, owl:DatatypeProperty ;
	rdfs:subPropertyOf geo:hasSerialization ;
	rdfs:domain geo:Geometry ;
	rdfs:range geo:gltfLiteral ;
	rdfs:isDefinedBy 
		<http://www.opengis.net/spec/geosparql/1.3/req/geometry-extension/geometry-as-gltf-literal> ;
	skos:definition """The GLTF serialization of a Geometry"""@en ;
	skos:prefLabel "as GLTF"@en ;
.

geo:gltfLiteral
    a rdfs:Datatype ;
    dcterms:description "A GLTF serialization of a Geometry object."@en ;
    dcterms:title "GLTF Literal"@en ;
    dcterms:conformsTo <https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html> ;
    geo:emptyExample """{"meshes":[]}"""^^geo:gltfLiteral ;
    geo:is3dCapable true ;
    geo:is2dCapable false ;
    geo:isCrsAware false ;
    geo:isCsAware true ;
    prov:qualifiedAttribution
        [
            prov:agent <https://defs.opengis.net/org/geosparql-swg> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    rim:hasAction
        [
            dcterms:isReplacedBy <https://www.opengis.net/def/vstatus/valid> ;
            prov:atTime "2026-10-29"^^xsd:date ;
            rim:affectedProperty rim:validityStatus ;
            rim:proposer <https://defs.opengis.net/org/geosparql-swg> ;
        ] ;
    rim:inRegister <https://www.opengis.net/def/catalog/ggld> ;
.

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov1: <http://www.w3.org/ns/prov-o#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rim: <https://w3id.org/ogc/rim/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

geo:jsonFGLiteral
    a rdfs:Datatype ;
    dcterms:description "A JSONFG serialization of a Geometry object."@en ;
    dcterms:title "JSONFG Literal"@en ;
    dcterms:conformsTo "https://docs.ogc.org/is/21-045r1/21-045r1.html"^^xsd:anyURI ;
    skos:example "{\"type\": \"Polygon\", \"coordinates\": [[[-83.6, 34.1], [-83.2, 34.1], [-83.2, 34.5], [-83.6, 34.5], [-83.6, 34.1]]], \"coordRefSys\": \"http://www.opengis.net/def/crs/OGC/1.3/CRS84\", \"conformsTo\": [\"http://www.opengis.net/spec/json-fg-1/1.0/conf/core\", \"http://www.opengis.net/spec/json-fg-1/1.0/conf/types-schemas\"]}"^^geo:jsonFGLiteral ;
    geo:is3dCapable false ;
    geo:is2dCapable true ;
    geo:isCrsAware false ;
    geo:supportsGeometryType
        sf:GeometryCollection ,
        sf:LineString ,
        sf:MultiLineString ,
        sf:MultiPoint ,
        sf:MultiPolygon ,
        sf:Point ,
        sf:Polygon ;
    prov1:qualifiedAttribution
        [
            prov1:agent <https://defs.opengis.net/org/geosparql-swg> ;
            prov1:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    rim:hasAction
        [
            dcterms:isReplacedBy <https://www.opengis.net/def/vstatus/valid> ;
            prov1:atTime "2026-10-29"^^xsd:date ;
            rim:affectedProperty rim:validityStatus ;
            rim:proposer <https://defs.opengis.net/org/geosparql-swg> ;
        ] ;
    rim:inRegister <https://www.opengis.net/def/catalog/ggld> ;
.

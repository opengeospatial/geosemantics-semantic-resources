
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov-o#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rim: <https://w3id.org/ogc/rim/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

geo:asPLY
	a rdf:Property, owl:DatatypeProperty ;
	rdfs:subPropertyOf geo:hasSerialization ;
	rdfs:domain geo:Geometry ;
	rdfs:range geo:plyLiteral ;
	rdfs:isDefinedBy 
		geo: , 
		<http://www.opengis.net/spec/geosparql/1.3/req/geometry-extension/geometry-as-ply-literal> ;
	skos:definition """The PLY serialization of a Geometry"""@en ;
	skos:prefLabel "as PLY"@en ;
.

geo:plyLiteral
    a rdfs:Datatype ;
    dcterms:description "A PLY serialization of a Geometry object."@en ;
    dcterms:title "PLY Literal"@en ;
    dcterms:conformsTo <https://paulbourke.net/dataformats/ply/> ;
    skos:example """ply
format ascii 1.0
comment https://github.com/mikedh/trimesh
element vertex 8
property float x
property float y
property float z
element face 12
property list uchar int vertex_indices
end_header
-83.59999847 34.09999847 0.00000000
-83.19999695 34.09999847 0.00000000
-83.19999695 34.50000000 0.00000000
-83.59999847 34.50000000 0.00000000
-83.59999847 34.09999847 0.10000000
-83.19999695 34.09999847 0.10000000
-83.19999695 34.50000000 0.10000000
-83.59999847 34.50000000 0.10000000
3 1 0 3
3 3 2 1
3 7 4 5
3 5 6 7
3 5 4 1
3 1 4 0
3 6 5 2
3 2 5 1
3 4 7 0
3 0 7 3
3 7 6 3
3 3 6 2
"""^^geo:plyLiteral ;
    geo:is3dCapable true ;
    geo:is2dCapable false ;
    geo:isCrsAware false ;
    geo:isCsAware true ;
    prov:qualifiedAttribution
        [
            prov:agent <https://defs.opengis.net/org/geosparql-swg> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    rim:hasAction
        [
            dcterms:isReplacedBy <https://www.opengis.net/def/vstatus/valid> ;
            prov:atTime "2026-10-29"^^xsd:date ;
            rim:affectedProperty rim:validityStatus ;
            rim:proposer <https://defs.opengis.net/org/geosparql-swg> ;
        ] ;
    rim:inRegister <https://www.opengis.net/def/catalog/ggld> ;
.

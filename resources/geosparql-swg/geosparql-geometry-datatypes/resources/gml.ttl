PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov-o#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rim: <https://w3id.org/ogc/rim/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>

geo:asGML
	a rdf:Property, owl:DatatypeProperty ;
	rdfs:subPropertyOf geo:hasSerialization ;
	rdfs:domain geo:Geometry ;
	rdfs:range geo:gmlLiteral ;
	rdfs:isDefinedBy  
		<http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-gml-literal> , 
		<http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-gml-literal> ;
	schema:description """The GML serialization of a Geometry"""@en ;
	schema:name "as GML"@en ;	
.

geo:gmlLiteral
    a rdfs:Datatype ;
    dcterms:description "The datatype of GML literal values"@en ;
    dcterms:title "GML literal"@en ;
    skos:example "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\" srsName=\"http://www.opengis.net/def/crs/EPSG/0/4326\"><gml:pos>31.95 -88.38</gml:pos></gml:Point>"^^geo:gmlLiteral ;
    geo:emptyExample """<![CDATA[
            <Point xmlns="https://www.opengis.net/gml"><posList></posList></Point>
        ]]>"""^^geo:gmlLiteral ;
    geo:is3dCapable true ;
    geo:is2dCapable true ;
    geo:isCrsAware true ;
    geo:supportsGeometryType
        sf:Curve ,
        sf:Envelope ,
        sf:Geometry ,
        sf:GeometryCollection ,
        sf:Line ,
        sf:LineString ,
        sf:LinearRing ,
        sf:MultiCurve ,
        sf:MultiLineString ,
        sf:MultiPoint ,
        sf:MultiPolygon ,
        sf:MultiSurface ,
        sf:Point ,
        sf:Polygon ,
        sf:PolyhedralSurface ,
        sf:Surface ,
        sf:TIN ,
        sf:Triangle ;
    prov:qualifiedAttribution
        [
            prov:agent <https://defs.opengis.net/org/geosparql-swg> ;
            prov:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    rim:hasAction
        [
            dcterms:isReplacedBy <https://www.opengis.net/def/vstatus/valid> ;
            prov:atTime "2026-10-29"^^xsd:date ;
            rim:affectedProperty rim:validityStatus ;
            rim:proposer <https://defs.opengis.net/org/geosparql-swg> ;
        ] ;
    rim:inRegister <https://www.opengis.net/def/catalog/ggld> ;
.

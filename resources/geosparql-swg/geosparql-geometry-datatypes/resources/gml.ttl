PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov1: <http://www.w3.org/ns/prov-o#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rim: <https://w3id.org/ogc/rim/>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

geo:gmlLiteral
    a rdfs:Datatype ;
    dcterms:description "The datatype of GML literal values"@en ;
    dcterms:title "GML literal"@en ;
    skos:example "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\" srsName=\"http://www.opengis.net/def/crs/EPSG/0/4326\"><gml:pos>31.95 -88.38</gml:pos></gml:Point>"^^geo:gmlLiteral ;
    geo:emptyExample """<![CDATA[
            <Point xmlns="https://www.opengis.net/gml"><posList></posList></Point>
        ]]>"""^^geo:gmlLiteral ;
    geo:is3dCapable true ;
    geo:is2dCapable true ;
    geo:isCrsAware true ;
    geo:supportsGeometryType
        sf:Curve ,
        sf:Envelope ,
        sf:Geometry ,
        sf:GeometryCollection ,
        sf:Line ,
        sf:LineString ,
        sf:LinearRing ,
        sf:MultiCurve ,
        sf:MultiLineString ,
        sf:MultiPoint ,
        sf:MultiPolygon ,
        sf:MultiSurface ,
        sf:Point ,
        sf:Polygon ,
        sf:PolyhedralSurface ,
        sf:Surface ,
        sf:TIN ,
        sf:Triangle ;
    prov1:qualifiedAttribution
        [
            prov1:agent <https://defs.opengis.net/org/geosparql-swg> ;
            prov1:hadRole <https://def.isotc211.org/codeset/RoleCode/custodian> ;
        ] ;
    rim:hasAction
        [
            dcterms:isReplacedBy <https://www.opengis.net/def/vstatus/valid> ;
            prov1:atTime "2026-10-29"^^xsd:date ;
            rim:affectedProperty rim:validityStatus ;
            rim:proposer <https://defs.opengis.net/org/geosparql-swg> ;
        ] ;
    rim:inRegister <https://www.opengis.net/def/catalog/ggld> ;
.

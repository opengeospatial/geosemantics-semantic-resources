digraph RIM {
graph [rankdir=TB, bgcolor="white", pad="0.45", nodesep="0.65", ranksep="1.05", splines=polyline, outputorder=edgesfirst, fontname="Times-Roman", labelloc=t, label="Registered Item Model (RIM)\nClasses and object properties — rim.ttl", fontsize=26];
node [shape=plain, fontname="Times-Roman"];
edge [fontname="Times-Roman", fontsize=13, color="black", arrowsize=0.8, penwidth=1.1];
"rdfs:Resource" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«external class»</FONT><BR/><B>rdfs:Resource</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"> </FONT></TD></TR></TABLE>>];
"prov:Agent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«external class»</FONT><BR/><B>prov:Agent</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"> </FONT></TD></TR></TABLE>>];
"rim:ChangeClassification" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:ChangeClassification</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:Concept<BR ALIGN="LEFT"/>values:<BR ALIGN="LEFT"/>  rim:clarifyingChange<BR ALIGN="LEFT"/>  rim:correctionalChange<BR ALIGN="LEFT"/>  rim:substantiveChange</FONT></TD></TR></TABLE>>];
"rim:Commitment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:Commitment</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"> </FONT></TD></TR></TABLE>>];
"rim:CommitmentCategory" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:CommitmentCategory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:Concept<BR ALIGN="LEFT"/>values:<BR ALIGN="LEFT"/>  rim:accessCommitment<BR ALIGN="LEFT"/>  rim:persistenceCommitment<BR ALIGN="LEFT"/>  rim:transparencyCommitment</FONT></TD></TR></TABLE>>];
"rim:Concept" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:Concept</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:Concept</FONT></TD></TR></TABLE>>];
"rim:ConceptSystem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:ConceptSystem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:ConceptScheme</FONT></TD></TR></TABLE>>];
"rim:ConceptVersion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:ConceptVersion</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ rim:functionalIdentifier : xsd:anyURI<BR ALIGN="LEFT"/>+ rim:isDeleted : xsd:boolean<BR ALIGN="LEFT"/>+ rim:isRedacted : xsd:boolean<BR ALIGN="LEFT"/>+ rim:objectIdentifier : xsd:anyURI</FONT></TD></TR></TABLE>>];
"rim:PublicationStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:PublicationStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:Concept<BR ALIGN="LEFT"/>values:<BR ALIGN="LEFT"/>  rim:published<BR ALIGN="LEFT"/>  rim:unpublished</FONT></TD></TR></TABLE>>];
"rim:Register" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:Register</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"> </FONT></TD></TR></TABLE>>];
"rim:RegisterAction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:RegisterAction</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends prov:Activity</FONT></TD></TR></TABLE>>];
"rim:RegisterActionType" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:RegisterActionType</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:Concept<BR ALIGN="LEFT"/>values:<BR ALIGN="LEFT"/>  rim:additionAction<BR ALIGN="LEFT"/>  rim:deletionAction<BR ALIGN="LEFT"/>  rim:invalidationAction<BR ALIGN="LEFT"/>  rim:publishAction<BR ALIGN="LEFT"/>  rim:redactionAction<BR ALIGN="LEFT"/>  rim:supersessionAction<BR ALIGN="LEFT"/>  rim:unpublishAction</FONT></TD></TR></TABLE>>];
"rim:RegisterItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:RegisterItem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ rim:functionalIdentifier : xsd:anyURI<BR ALIGN="LEFT"/>+ rim:isDeleted : xsd:boolean<BR ALIGN="LEFT"/>+ rim:isRedacted : xsd:boolean<BR ALIGN="LEFT"/>+ rim:objectIdentifier : xsd:anyURI</FONT></TD></TR></TABLE>>];
"rim:RegisterItemClass" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:RegisterItemClass</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"> </FONT></TD></TR></TABLE>>];
"rim:RegisterSpecification" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:RegisterSpecification</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ rim:definesSubstantiveChange : xsd:string</FONT></TD></TR></TABLE>>];
"rim:RegisterSystem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:RegisterSystem</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"> </FONT></TD></TR></TABLE>>];
"rim:ValidityStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">«owl:Class»</FONT><BR/><B>rim:ValidityStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">extends skos:Concept<BR ALIGN="LEFT"/>values:<BR ALIGN="LEFT"/>  rim:invalid<BR ALIGN="LEFT"/>  rim:valid</FONT></TD></TR></TABLE>>];
"rim:Commitment" -> "rim:CommitmentCategory" [label="rim:commitmentCategory"];
"rim:ConceptVersion" -> "rim:Concept" [label="rim:versionOf"];
"rim:ConceptVersion" -> "rim:PublicationStatus" [label="rim:publicationStatus"];
"rim:ConceptVersion" -> "rim:ValidityStatus" [label="rim:validityStatus"];
"rim:Register" -> "prov:Agent" [label="rim:controlBody\nrim:registerManager\nrim:registerOwner\nrim:registerSystemManager\nrim:registerUser"];
"rim:Register" -> "rim:Commitment" [label="rim:hasCommitment"];
"rim:Register" -> "rim:RegisterSpecification" [label="rim:hasSpecification"];
"rim:Register" -> "rim:RegisterSystem" [label="rim:runsOn"];
"rim:RegisterAction" -> "prov:Agent" [label="rim:proposer"];
"rim:RegisterAction" -> "rim:ChangeClassification" [label="rim:changeClassification"];
"rim:RegisterAction" -> "rim:RegisterActionType" [label="rim:actionType"];
"rim:RegisterItem" -> "rim:ConceptVersion" [label="rim:realizes"];
"rim:RegisterItem" -> "rim:PublicationStatus" [label="rim:publicationStatus"];
"rim:RegisterItem" -> "rim:Register" [label="rim:inRegister"];
"rim:RegisterItem" -> "rim:RegisterItem" [label="rim:relatedItem\nrim:supersededBy\nrim:supersedes"];
"rim:RegisterItem" -> "rim:RegisterItemClass" [label="rim:itemClass"];
"rim:RegisterItem" -> "rim:ValidityStatus" [label="rim:validityStatus"];
"rim:RegisterItemClass" -> "rdfs:Resource" [label="rim:validatedBy"];
"rim:RegisterItemClass" -> "rim:Register" [label="rim:definedIn"];
"rim:RegisterItem" -> "rim:RegisterAction" [dir=both, label="→ rim:hasAction\n← rim:appliesTo"];
legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">Arrow: property domain → range. Opposed arrows: named inverse properties.<BR ALIGN="LEFT"/>Attributes: declared datatype properties. “extends”: rdfs:subClassOf.<BR ALIGN="LEFT"/>Union domains are expanded to each member class. Listed values are named instances.<BR ALIGN="LEFT"/>No multiplicities are inferred from OWL domains/ranges. External classes are included as link targets.<BR ALIGN="LEFT"/>rim: https://w3id.org/ogc/rim/ · prov: http://www.w3.org/ns/prov#<BR ALIGN="LEFT"/>skos: http://www.w3.org/2004/02/skos/core# · rdfs: http://www.w3.org/2000/01/rdf-schema#<BR ALIGN="LEFT"/>xsd: http://www.w3.org/2001/XMLSchema#</FONT></TD></TR></TABLE>>];
}
